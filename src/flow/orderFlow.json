{
  "version": "7.1",
  "screens": [
    {
      "id": "ORDER",
      "title": "Aaj ka order",
      "terminal": true,
      "success": true,
      "data": {
        "heading": {
          "type": "string",
          "__example__": "Tiffin ₹80 · Saath mein: Dal Bhat, Fryms"
        },
        "sabji_label": {
          "type": "string",
          "__example__": "Sabji (koi 1 chunein)"
        },
        "sabji_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "0", "title": "Paneer Bhurji Sabji", "description": "₹80" },
            { "id": "1", "title": "Sev Tameta", "description": "₹80" }
          ]
        },
        "bread_visible": { "type": "boolean", "__example__": true },
        "bread_label": { "type": "string", "__example__": "Roti / Thepla (koi 1)" },
        "bread_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "0", "title": "5 Roti", "description": "" },
            { "id": "1", "title": "4 Thepla", "description": "" }
          ]
        },
        "extras_visible": { "type": "boolean", "__example__": true },
        "extra_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "0", "title": "Dhokla", "description": "₹40" }
          ]
        },
        "qty_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "1" },
            { "id": "2", "title": "2" },
            { "id": "3", "title": "3" }
          ]
        },
        "address": { "type": "string", "__example__": "9 Lake View, Satellite" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "${data.heading}"
          },
          {
            "type": "Form",
            "name": "order_form",
            "init-values": {
              "address": "${data.address}"
            },
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "sabji",
                "label": "${data.sabji_label}",
                "data-source": "${data.sabji_options}",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "bread",
                "label": "${data.bread_label}",
                "data-source": "${data.bread_options}",
                "visible": "${data.bread_visible}",
                "required": false
              },
              {
                "type": "CheckboxGroup",
                "name": "extras",
                "label": "Extra items (jitne chahein)",
                "data-source": "${data.extra_options}",
                "visible": "${data.extras_visible}",
                "required": false
              },
              {
                "type": "Dropdown",
                "name": "qty",
                "label": "Kitne tiffin?",
                "data-source": "${data.qty_options}",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "address",
                "label": "Delivery address",
                "input-type": "text",
                "required": true,
                "helper-text": "Ghar/flat no, building, area"
              },
              {
                "type": "Footer",
                "label": "Order confirm karein",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "sabji": "${form.sabji}",
                    "bread": "${form.bread}",
                    "extras": "${form.extras}",
                    "qty": "${form.qty}",
                    "address": "${form.address}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
