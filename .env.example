# ===== WhatsApp Cloud API (from developers.facebook.com > your app > WhatsApp > API Setup) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=tiffin-bot-verify-123

# ===== LLM provider (FREE tiers — swappable anytime) =====
# Primary: Google Gemini free tier — key from https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Fallback: Groq free tier — key from https://console.groq.com
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# ===== Google Sheets (service account JSON from console.cloud.google.com) =====
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# paste the private_key value from the JSON, keep the quotes and \n characters
GOOGLE_PRIVATE_KEY=""
SHEET_ID=

# ===== Business config (edit after talking to shop owner) =====
SHOP_NAME=Sharma Tiffin & Snacks
OWNER_PHONE=91XXXXXXXXXX
TIFFIN_PRICE=80
INCLUDED_ROTIS=4
EXTRA_ROTI_PRICE=8
ORDER_CUTOFF=12:00
MENU_REMINDER_TIME=08:00
MENU_BROADCAST_TIME=10:30
PAYMENT_MESSAGE_TIME=19:30
REMINDER_TIME=10:00
SUMMARY_TIME=21:00
UPI_ID=shopowner@upi
DELIVERY_RADIUS_NOTE=3km
TZ=Asia/Kolkata
PORT=3000
